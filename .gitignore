# Python
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Test and coverage
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store
.Thumbs.db

# Build outputs and temporary files
*.o
*.so

# Scoring and sweep outputs. Regenerated by run_all.sh on every run, so
# committing them would only ever produce merge conflicts over derived data.
results/
runs/

# Datasets. GOOSE is 6 GB of CC BY-SA 4.0 data that this repo does not
# redistribute, and the zips are what a candidate downloads for themselves.
data/
*.zip

# The synthetic fixture. Reproducible from a seed, so the seed is the artefact
# and the megabytes of npz and png it expands into are not. .fixture/ is the
# in-tree name and semseg-fixture/ is what a FIXTURE pointed inside the repo
# would create; run_all.sh defaults FIXTURE outside the tree for this reason.
.fixture/
semseg-fixture/

# Submissions written by a local run, which run_all.sh keeps under $FIXTURE but
# a hand invocation will drop wherever it was pointed. The negation is load
# bearing: .github/workflows/autograde.yml scores exactly /submission.json, so
# a deliberately committed one at the repo root has to stay visible to git,
# along with the compute sidecar that belongs with it.
submission*.json
!/submission.json
!/submission.json.meta.json
